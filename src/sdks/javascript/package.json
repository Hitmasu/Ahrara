{
  "name": "@ahrara/sdk",
  "version": "0.1.0",
  "description": "Disposable email inboxes powered by the shared Ahrara Rust core",
  "license": "MIT",
  "homepage": "https://ahrara.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hitmasu/Ahrara.git",
    "directory": "src/sdks/javascript"
  },
  "bugs": "https://github.com/Hitmasu/Ahrara/issues",
  "keywords": [
    "email",
    "disposable-email",
    "testing",
    "qa",
    "playwright",
    "cypress",
    "automation"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native",
    "README.md",
    "LICENSE-THIRD-PARTY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/inbox.test.mjs",
    "test:types": "tsc --noEmit --strict --module nodenext --target es2022 test/types.ts",
    "test:playwright": "playwright test",
    "test:cypress": "cypress run --browser electron",
    "format:check": "prettier --check index.js index.d.ts package.json package-lock.json \"*.config.*\" \"test/**/*.{js,mjs,ts}\" \"cypress/**/*.js\""
  },
  "dependencies": {
    "koffi": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "cypress": "15.21.1",
    "nodemailer": "10.0.13",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  }
}
